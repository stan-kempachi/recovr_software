# Environnement (development, staging, production)
ENVIRONMENT=development

# Clés secrètes Django
SECRET_KEY=votre_cle_secrete_de_developpement
STAGING_SECRET_KEY=votre_cle_secrete_de_staging
PRODUCTION_SECRET_KEY=votre_cle_secrete_de_production

# Configuration de débogage
DEBUG=True

# Configuration des hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuration de la base de données
DB_ENGINE=django.db.backends.postgresql
DB_NAME=recovr
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432